# ================================================================
# IHI (Innovation Hackathon Infrastructure) — .gitignore
# ================================================================

# ── Dependencies ───────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Next.js Build & Outputs ────────────────────────────────────
.next/
out/
build/
dist/
.open-next/

# ── Production & Local Environment Secrets ─────────────────────
# (Never commit actual secret keys or credentials to git)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# (Optional: Allow committing example/template env files)
!.env.example
!.env.local.example

# ── Supabase Local Data & Secrets ──────────────────────────────
# Keep migrations and config.toml tracked, ignore local db states
.branches/
.temp/
supabase/.temp/

# ── Logs & Debugging ───────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Testing & Coverage ─────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
.cypress-cache/

# ── IDEs & System Files ────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# VS Code / JetBrains / Editors
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.settings/

# (Allow essential VS Code settings if team shares them, ignore user-specific state)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ── Turbo / Cache ──────────────────────────────────────────────
.turbo/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
next-env.d.ts.bak